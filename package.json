{
  "name": "hhh-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design system, server kit and tooling configs for the HuttonHomeHub apps",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/pack-release.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && node scripts/build-tokens.ts --check && npm run test:coverage && npm run build && npm audit --audit-level=high",
    "tokens": "node scripts/build-tokens.ts",
    "showcase": "vite build --config packages/ui/showcase/vite.config.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.73.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
