{
  "name": "hhh-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design system, server kit and tooling configs for the HuttonHomeHub apps",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/pack-release.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
