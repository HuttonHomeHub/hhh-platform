{
  "name": "hhh-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design system, server kit and tooling configs for the HuttonHomeHub apps",
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build:server && node scripts/pack-release.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && node scripts/build-tokens.ts --check && npm run build:server && npm run test:coverage && node scripts/pack-release.ts && npm audit --audit-level=high",
    "tokens": "node scripts/build-tokens.ts",
    "showcase": "vite build --config packages/ui/showcase/vite.config.ts",
    "screenshots": "node scripts/screenshots.ts",
    "build:server": "tsc -p packages/server/tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/better-sqlite3": "9.6.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "better-sqlite3": "13.1.1",
    "compression": "1.8.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "globals": "17.14.0",
    "helmet": "8.3.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.73.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  }
}
